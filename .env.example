# Configuración de Producción para SCV

# Dominio de la aplicación (usado para redirecciones y CORS si es necesario)
DOMAIN=midominio.com

# Credenciales de Base de Datos
POSTGRES_DB=scv_database_prod
POSTGRES_USER=scv_admin_prod
# IMPORTANTE: Cambiar esta contraseña
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD_HERE

# Backend API
# IMPORTANTE: Generar una nueva clave con `openssl rand -hex 32`
SECRET_KEY=YOUR_SECRET_KEY_HERE
ENVIRONMENT=production
ENABLE_API_DOCS=False

# Let's Encrypt (Email para notificaciones de expiración)
CERTBOT_EMAIL=admin@midominio.com
