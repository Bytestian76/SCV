[Unit]
Description=SCV FastAPI Backend
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/scv-backend
EnvironmentFile=/opt/scv-backend/.env
ExecStart=/opt/scv-backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 9000 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
