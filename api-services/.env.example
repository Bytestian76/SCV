PROJECT_NAME="SCV - Sistema de Control Vehicular API"
ENVIRONMENT=development
ENABLE_API_DOCS=True

# Conexión a PostgreSQL (o SQLite para pruebas locales sin docker)
DATABASE_URL=postgresql+psycopg2://scv_user:scv_password_2026@localhost:5432/scv_database
# DATABASE_URL=sqlite:///./scv.db

# Configuración de Seguridad y JWT
SECRET_KEY=scv_dev_secret_key_change_in_production_2026_super_secure_random_hash
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS
CORS_ORIGINS=["http://localhost", "http://localhost:80", "http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:5173"]
