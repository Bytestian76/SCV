server {
    listen 443 ssl;
    server_name test-scv.normetales.xyz;

    ssl_certificate /etc/letsencrypt/live/test-scv.normetales.xyz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/test-scv.normetales.xyz/privkey.pem;

    location /api/ {
        proxy_pass http://scv-backend-staging:9000/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://scv-frontend-staging:80;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80;
    server_name test-scv.normetales.xyz;
    return 301 https://$host$request_uri;
}
